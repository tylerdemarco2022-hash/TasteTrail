# Yelp
YELP_API_KEY=your_yelp_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Public API origin baked into the web/iOS build. Use HTTPS for App Store builds.
# Leave unset during local `npm run dev` to use http://localhost:8081.
VITE_API_BASE_URL=

# Nearby restaurant discovery for live menus. Enable Places API (New) in Google Cloud.
# Menus are read from each restaurant's website or menu PDF, not from Google.
# Leave blank to discover nearby restaurants from OpenStreetMap instead (no key).
# With this key, nearby search uses the Enterprise field set (website, hours, rating):
# about $35 per 1,000 requests after 1,000 free requests per month.
# Photo images are separate, about $7 per 1,000 after 1,000 free.
GOOGLE_PLACES_API_KEY=

# Hours to reuse a retrieved menu before fetching it again. Default 12.
MENU_CACHE_TTL_HOURS=12

# Optional directory for the on-disk menu cache. Defaults to taste-trails/data/menu-cache.
MENU_CACHE_DIR=
